#!/bin/sh
":" //# ; if [ -n "${AGENT_CANVAS_SHIM_REEXEC-}" ]; then echo "stellar: invalid AGENT_CANVAS_NODE interpreter" >&2; exit 127; fi; case "${AGENT_CANVAS_NODE-}" in '${'*) AGENT_CANVAS_NODE=;; esac; __u=${AGENT_CANVAS_MCP_URL-}; case "$__u" in http://127.0.0.1:*/*|http://localhost:*/*) __r=${__u#http://}; __r=${__r#localhost:}; __r=${__r#127.0.0.1:}; __p=${__r%%/*}; __s="${TMPDIR:-/tmp}/stellar-mcp-relay-${__p}.sock"; __d=${0%/*}; [ "$__d" = "$0" ] && __d=.; if [ -S "$__s" ] && [ -x "$__d/stellar-mcp-relay" ]; then exec "$__d/stellar-mcp-relay"; fi;; esac; AGENT_CANVAS_SHIM_REEXEC=1 ELECTRON_RUN_AS_NODE=1 exec "${AGENT_CANVAS_NODE:-node}" "$0" "$@"

import net from "node:net";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { URL } from "node:url";

delete process.env.AGENT_CANVAS_SHIM_REEXEC;

function log(message) {
  process.stderr.write(`stellar-mcp: ${message}\n`);
}

const rawUrl = process.env.AGENT_CANVAS_MCP_URL;
if (!rawUrl || rawUrl.startsWith("${")) {
  log("AGENT_CANVAS_MCP_URL is unavailable; no Stellar tools are exposed outside a card.");
  process.exitCode = 2;
} else {
  let socketPath;
  try {
    const url = new URL(rawUrl);
    if ((url.hostname !== "127.0.0.1" && url.hostname !== "localhost") || !url.port || url.protocol !== "http:") {
      throw new Error("the app MCP URL is not local");
    }
    socketPath = join(process.env.TMPDIR || tmpdir(), `stellar-mcp-relay-${url.port}.sock`);
  } catch (error) {
    log(`invalid app MCP URL: ${String(error)}`);
    process.exitCode = 2;
  }

  if (socketPath) {
    const socket = net.createConnection({ path: socketPath });
    socket.on("connect", () => process.stdin.pipe(socket));
    socket.pipe(process.stdout);
    socket.on("error", (error) => {
      log(`could not connect to the authenticated app relay: ${error.message}`);
      process.exitCode = 5;
      process.stdin.unpipe(socket);
    });
    socket.on("end", () => process.exit(0));
    process.stdin.on("end", () => socket.end());
  }
}
