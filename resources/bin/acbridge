#!/bin/sh
":" //# ; if [ -n "${AGENT_CANVAS_SHIM_REEXEC-}" ]; then echo "stellar: AGENT_CANVAS_NODE='${AGENT_CANVAS_NODE-}' nao e um interpretador node" >&2; exit 127; fi; AGENT_CANVAS_SHIM_REEXEC=1 ELECTRON_RUN_AS_NODE=1 exec "${AGENT_CANVAS_NODE:-node}" "$0" "$@"
// Polyglot sh/node deliberado, não um acidente (2026-09-08), e a ORDEM
// das duas linhas acima é obrigatória. O shebang `#!/usr/bin/env node`
// que estava aqui exigia `node` no PATH do processo que lança este
// arquivo — e num `.app` aberto pelo Finder no macOS esse PATH é o que o
// `path_helper` monta, sem nenhum diretório de usuário. Resultado: este
// shim morria com "env: node: No such file or directory" antes de
// responder ao handshake, e quem o lança é a CLI do usuário
// (cursor/agy/opencode), cujo ambiente o Stellar não controla na hora do
// lançamento.
//
// Como funciona: para o `sh`, a linha 2 é `:` (no-op) seguido de um
// `exec`, então ele re-executa este mesmo arquivo com o interpretador
// certo e nunca chega na linha 3. Para o node, a linha 2 é a string ":"
// seguida de um comentário. Todo comentário explicativo precisa ficar
// DEPOIS do exec e em `//`: o node só descarta a primeira linha quando
// ela é um shebang, então um bloco `#` aqui em cima é erro de sintaxe
// (quebrado e corrigido ao vivo escrevendo isto).
//
// `AGENT_CANVAS_NODE` é o binário do próprio Electron, injetado por
// pty-registry.ts em todo processo spawnado e herdado daí pela CLI que
// lança este shim; `node` do PATH é o fallback para quando o shim roda
// fora do Stellar, onde o PATH é rico. `ELECTRON_RUN_AS_NODE` é setado
// aqui mesmo para não depender de quem lançou; o node normal ignora.
// Standalone CLI, no project dependencies — put on PATH for every spawned
// provider card. Lets a provider's own shell tool talk to the app: list
// other open terminal cards, type a message into one of them, ask
// permission to open a URL/spawn a card/spawn another agent, snapshot the
// canvas, or read a browser card's rendered text.
//
// DESIGN-BACKLOG.md item 21, ponto 9 — the primary agent-facing interface
// is now the MCP server (mcp-server.ts, same backend via message-bus.ts's
// shared handleRequest) for providers that speak MCP. This CLI stays as
// the lowest-common-denominator fallback (works for ANY shell-capable
// process, no MCP client required) and as a human-debuggable way to poke
// the same backend from a terminal.
//
// ESM, not CommonJS: Node resolves a shebang script with no .cjs extension
// by walking up to the nearest package.json's "type" field, and
//
// A sentinela `AGENT_CANVAS_SHIM_REEXEC` fecha um loop infinito real
// (achado em review, confirmado medindo: exit 124 a 100% de CPU). Se
// `AGENT_CANVAS_NODE` apontar para um shell em vez de um node — e a
// variável é herdada por todo processo spawnado, então qualquer agente
// pode setá-la —, o `exec` re-executa este mesmo arquivo, que re-executa,
// para sempre. Com a sentinela a segunda passada falha na hora, com
// mensagem que nomeia a variável culpada. O lado JS a remove do ambiente
// logo abaixo, para que um processo neto que legitimamente chame um shim
// não herde a guarda e seja recusado à toa.
// agent-canvas's is "module" — require() would fail here at runtime.
import net from "node:net";

// Ver a nota da sentinela no topo: fora daqui ela não tem função, e
// deixá-la no ambiente faria um neto que chame um shim ser recusado.
delete process.env.AGENT_CANVAS_SHIM_REEXEC;


const sockPath = process.env.AGENT_CANVAS_SOCK;
const ownCardId = process.env.AGENT_CANVAS_CARD_ID || "";
// Same auto-fill class as ownCardId: when this card was spawned for a
// task, the PTY env already has the full id (pty-registry.ts). `report`
// stamps it onto the JSON so the agent does not copy a truncated id
// from a briefing. Absent when the spawn had no task — first-class.
const ownTaskId = process.env.AGENT_CANVAS_TASK_ID || "";

// Versão do protocolo JSON-line que este script fala. O agente executa o
// acbridge do PACOTE instalado (extraResources copia resources/bin), que
// pode ser mais velho ou mais novo que o Stellar que bindou o socket (dev
// e empacotado compartilham o mesmo userData/.sock). Sem esta marca a
// defasagem era silenciosa: campo desconhecido sumia com `ok` (achado ao
// vivo 2026-09-13, `verdict` de um relatório reprovado virando NULL).
// Carimbado em TODO request; o bus aceita+avisa quando este lado é mais
// velho e RECUSA quando é mais novo. Mesmo literal em
// src/main/acbridge-protocol-decision.ts — o vitest trava os dois
// (tests/unit/acbridge-protocol.test.ts). Bump quando a forma de um
// request muda (cmd/campo novo), e só então.
const ACBRIDGE_PROTOCOL = 1;

function fail(msg) {
  process.stderr.write(`acbridge: ${msg}\n`);
  process.exit(1);
}

if (!sockPath) {
  fail("AGENT_CANVAS_SOCK is not set — not running inside agent-canvas?");
}

const USAGE =
  "usage: acbridge <version | list | send <cardId> <message...> | get-delivery <id> | open <url> | " +
  "close-card <cardId> [reason...] | delete-card <cardId> [reason...] | " +
  "update-card-content [--append] <cardId> <text...> | " +
  "snapshot [cardId | x y w h] | page-text <cardId> | read-card <cardId> [lines] | " +
  "read-sticky <cardId> | write-sticky [--append] [--file <path>] <cardId> [text...] | " +
  "card-status <cardId> | report <json> | read-report <cardId> [waitTimeoutMs] | " +
  "create-task <json> | update-task <taskId> <json> | request-task-status <taskId> <status> [reason...] | list-tasks | get-task <taskId> | " +
  "link-task-card <taskId> <cardId> [implementer|reviewer] | " +
  "list-connectors | set-connector-kind <connectorId> <context|depends|null> | " +
  "set-connector-label <connectorId> <label...|null> | " +
  "concurrency-status [cap] | board-mode <cardId> | " +
  "spawn-agent <provider> [cwd] [resumeId] [--model <model>] [--effort <low|medium|high|xhigh|max>] [--task <taskId>] [--role <implementer|reviewer>] [--brief <text>] | " +
  "spawn-card <files|changes|sticky|browser|remote-window> [cwd|url] [--anchor <cardId>] [--side <left|right|top|bottom>] | " +
  "browser-click <cardId> <selector> | browser-type <cardId> <selector> <text...> | " +
  "browser-scroll <cardId> <dx> <dy> [selector] | browser-query <cardId> <selector> | " +
  "browser-snapshot <cardId> | browser-console <cardId> [level] | " +
  "browser-network <cardId> [failed] | browser-wait-for <cardId> <text|selector> <value...> | " +
  "browser-eval <cardId> <js...>>";

// DESIGN-BACKLOG.md §2.1 points 3–4 — printed with bare `acbridge` usage.
// Capability without MCP/system-prompt is real on bash cards; identity of
// a hand-launched nested agent is a known gap (claim-card declined).
const BASH_CARD_NOTE =
  "note: inside a bash card, this CLI is on PATH but hand-launched agents " +
  "do not get `stellar` MCP tools or the environment system-prompt — prefer " +
  "a provider card. Actions here are attributed to AGENT_CANVAS_CARD_ID " +
  "(the bash card); nested-agent identity is a known gap.";

const [, , cmd, ...rest] = process.argv;

let request;
if (cmd === "version") {
  // Handshake explícito: imprime o protocolo deste script e o do bus que
  // atendeu, com o veredito — o jeito barato de um orquestrador conferir
  // "falamos a mesma língua?" antes de confiar num `ok`.
  request = { cmd: "hello" };
} else if (cmd === "list") {
  request = { cmd: "list" };
} else if (cmd === "send") {
  const [target, ...msgParts] = rest;
  if (!target || msgParts.length === 0) fail("usage: acbridge send <cardId> <message...>");
  // DESIGN-BACKLOG.md item 61 — same auto-fill as `report`'s ownCardId
  // above, no new flag needed: whenever this runs inside a real card
  // (AGENT_CANVAS_CARD_ID set), the delivered text gets a sender label
  // automatically. Omitted (not failed) when unset — unlike `report`,
  // `send` still works from outside a card context, just unprefixed.
  request = { cmd: "send", target, text: msgParts.join(" "), ...(ownCardId ? { requesterId: ownCardId } : {}) };
} else if (cmd === "get-delivery") {
  const [id] = rest;
  if (!id) fail("usage: acbridge get-delivery <id>");
  request = { cmd: "get_delivery", id };
} else if (cmd === "open") {
  const [url] = rest;
  if (!url) fail("usage: acbridge open <url>");
  request = { cmd: "open", url, requesterId: ownCardId };
} else if (cmd === "close-card") {
  const [target, ...reasonParts] = rest;
  if (!target) fail("usage: acbridge close-card <cardId> [reason...]");
  request = { cmd: "close_card", target, reason: reasonParts.length ? reasonParts.join(" ") : undefined, requesterId: ownCardId };
} else if (cmd === "delete-card") {
  // Pendentes #188 — reaches a card on ANY board, not just the one
  // currently loaded (close-card can't: no live UI on any other board).
  const [target, ...reasonParts] = rest;
  if (!target) fail("usage: acbridge delete-card <cardId> [reason...]");
  request = { cmd: "delete_card", target, reason: reasonParts.length ? reasonParts.join(" ") : undefined, requesterId: ownCardId };
} else if (cmd === "update-card-content") {
  const append = rest[0] === "--append";
  const [target, ...textParts] = append ? rest.slice(1) : rest;
  if (!target || textParts.length === 0) fail("usage: acbridge update-card-content [--append] <cardId> <text...>");
  request = { cmd: "update_card_content", target, content: textParts.join(" "), mode: append ? "append" : "replace", requesterId: ownCardId };
} else if (cmd === "snapshot") {
  if (rest.length === 0) {
    request = { cmd: "snapshot" };
  } else if (rest.length === 1) {
    request = { cmd: "snapshot", target: rest[0] };
  } else if (rest.length === 4) {
    const [x, y, w, h] = rest.map(Number);
    if ([x, y, w, h].some(Number.isNaN)) fail("snapshot: x/y/w/h must be numbers");
    request = { cmd: "snapshot", rect: { x, y, w, h } };
  } else {
    fail("usage: acbridge snapshot [cardId | x y w h]");
  }
} else if (cmd === "page-text") {
  const [target] = rest;
  if (!target) fail("usage: acbridge page-text <cardId>");
  request = { cmd: "get_page_text", target };
} else if (cmd === "read-card") {
  const [target, linesStr] = rest;
  if (!target) fail("usage: acbridge read-card <cardId> [lines]");
  const lines = linesStr === undefined ? undefined : Number(linesStr);
  if (lines !== undefined && Number.isNaN(lines)) fail("read-card: lines must be a number");
  request = { cmd: "read_card", target, lines };
} else if (cmd === "read-sticky") {
  const [target] = rest;
  if (!target) fail("usage: acbridge read-sticky <cardId>");
  request = { cmd: "read_sticky", target };
} else if (cmd === "write-sticky") {
  // Flags SÓ no começo, antes do alvo: o texto é `...rest` até o fim
  // (pode conter qualquer coisa, inclusive algo que pareça uma flag),
  // então uma flag posicional no fim seria ambígua.
  //
  // `--file` é a mesma escolha content-ou-path que o MCP expõe, e aqui
  // ela pesa mais: sem ela o texto inteiro vira argv de um comando de
  // shell — aspas, limite de tamanho e o classificador de permissão do
  // host olhando o bloco cru. Com ela o main lê o arquivo (mesmo
  // confine + 512KB), e o comando carrega só o caminho.
  let args = rest;
  let append = false;
  let filePath = null;
  for (;;) {
    if (args[0] === "--append") {
      append = true;
      args = args.slice(1);
    } else if (args[0] === "--file") {
      if (args[1] === undefined) fail("write-sticky: --file needs a path");
      filePath = args[1];
      args = args.slice(2);
    } else break;
  }
  const [target, ...textParts] = args;
  const usage = "usage: acbridge write-sticky [--append] [--file <path>] <cardId> [text...]";
  if (!target) fail(usage);
  if (filePath === null && textParts.length === 0) fail(usage);
  if (filePath !== null && textParts.length > 0) fail("write-sticky: pass --file or text, not both");
  const mode = append ? "append" : "replace";
  // `requesterId` faltava aqui e está presente em `update-card-content`,
  // que DELEGA pra este mesmo comando: sem ele o auto-conector nunca era
  // desenhado por esta via, e `--file` não teria root nenhum contra o
  // qual confinar o caminho (o cwd sai do card chamador).
  const stickyBase = { cmd: "write_sticky", target, mode, ...(ownCardId ? { requesterId: ownCardId } : {}) };
  if (filePath !== null && !ownCardId) {
    fail("write-sticky --file: AGENT_CANVAS_CARD_ID is not set — no card root to confine the path against; pass the text inline instead");
  }
  request = filePath !== null ? { ...stickyBase, path: filePath } : { ...stickyBase, content: textParts.join(" ") };
} else if (cmd === "card-status") {
  const [target] = rest;
  if (!target) fail("usage: acbridge card-status <cardId>");
  request = { cmd: "card_status", target };
} else if (cmd === "turn-complete") {
  // Prototipo (2026-09-06) — chamado por um hook `Stop` (providers.ts's
  // buildArgs do claude, --settings efêmero), nunca por um humano/agente
  // diretamente. Sem argumentos: `cardId` vem só do próprio
  // AGENT_CANVAS_CARD_ID do processo que roda o hook, mesmo auto-fill de
  // `report` acima.
  if (!ownCardId) fail("turn-complete: AGENT_CANVAS_CARD_ID is not set — not running inside agent-canvas?");
  request = { cmd: "turn_complete", cardId: ownCardId };
} else if (cmd === "report") {
  const [json] = rest;
  if (!json) fail("usage: acbridge report <json>");
  if (!ownCardId) fail("report: AGENT_CANVAS_CARD_ID is not set — not running inside agent-canvas?");
  let report;
  try {
    report = JSON.parse(json);
  } catch {
    fail("report: argument must be valid JSON");
  }
  if (
    ownTaskId &&
    report &&
    typeof report === "object" &&
    !Array.isArray(report) &&
    !Object.prototype.hasOwnProperty.call(report, "taskId")
  ) {
    report = { ...report, taskId: ownTaskId };
  }
  // Keep in lockstep with report-verdict-decision.ts `promoteReportVerdict`.
  // The CLI has one JSON argument; a formal `verdict` inside it is the
  // typed request field (MCP sends that separately). Lift it off the
  // payload so the column and `report_json` are not two copies.
  let verdict;
  if (report && typeof report === "object" && !Array.isArray(report)) {
    const embedded = report.verdict;
    if (embedded === "aprovado" || embedded === "reprovado") {
      verdict = embedded;
      const { verdict: _drop, ...rest } = report;
      report = rest;
    }
  }
  request = { cmd: "report", requesterId: ownCardId, report, ...(verdict ? { verdict } : {}) };
} else if (cmd === "read-report") {
  const [target, waitTimeoutMsStr] = rest;
  if (!target) fail("usage: acbridge read-report <cardId> [waitTimeoutMs]");
  const timeoutMs = waitTimeoutMsStr === undefined ? undefined : Number(waitTimeoutMsStr);
  if (timeoutMs !== undefined && Number.isNaN(timeoutMs)) fail("read-report: waitTimeoutMs must be a number");
  request = { cmd: "get_report", target, wait: timeoutMs !== undefined, timeoutMs };
} else if (cmd === "create-task") {
  const [json] = rest;
  let fields = {};
  if (json) {
    try {
      fields = JSON.parse(json);
    } catch {
      fail("create-task: argument must be valid JSON");
    }
  }
  request = { cmd: "create_task", ...fields };
} else if (cmd === "update-task") {
  const [taskId, json] = rest;
  if (!taskId || !json) fail("usage: acbridge update-task <taskId> <json>");
  let fields;
  try {
    fields = JSON.parse(json);
  } catch {
    fail("update-task: argument must be valid JSON");
  }
  request = { cmd: "update_task", taskId, ...fields, ...(ownCardId ? { requesterId: ownCardId } : {}) };
} else if (cmd === "request-task-status") {
  const [taskId, status, ...reasonParts] = rest;
  if (!taskId || !status) fail("usage: acbridge request-task-status <taskId> <status> [reason...]");
  request = {
    cmd: "request_task_status",
    taskId,
    status,
    reason: reasonParts.length > 0 ? reasonParts.join(" ") : undefined,
    ...(ownCardId ? { requesterId: ownCardId } : {}),
  };
} else if (cmd === "list-tasks") {
  request = { cmd: "list_tasks" };
} else if (cmd === "get-task") {
  const [taskId] = rest;
  if (!taskId) fail("usage: acbridge get-task <taskId>");
  request = { cmd: "get_task", taskId };
} else if (cmd === "link-task-card") {
  // Paridade com a tool MCP `link_task_card` (2026-09-13): papel de um card
  // JÁ ABERTO numa task. `role` omitido = implementer (o bus decide o
  // default, não a CLI); valor desconhecido é recusado pelo bus, nunca
  // normalizado aqui.
  const [taskId, cardId, role] = rest;
  if (!taskId || !cardId) fail("usage: acbridge link-task-card <taskId> <cardId> [implementer|reviewer]");
  request = { cmd: "link_task_card", taskId, cardId, role, requesterId: ownCardId };
} else if (cmd === "list-connectors") {
  request = { cmd: "list_connectors" };
} else if (cmd === "set-connector-kind") {
  const [connectorId, kindStr] = rest;
  if (!connectorId || !kindStr) fail("usage: acbridge set-connector-kind <connectorId> <context|depends|null>");
  // `requesterId` (2026-09-11) — `set_connector_kind` passou a exigir
  // chamador identificado desde que `spawned` decide o roteamento do push
  // de report; ver connector-kind-authorization.ts. Mesma fonte que todo
  // outro cmd mutante daqui já usa.
  request = { cmd: "set_connector_kind", connectorId, kind: kindStr === "null" ? null : kindStr, requesterId: ownCardId };
} else if (cmd === "set-connector-label") {
  // Espelha set-connector-kind acima (mesmo trio uso/parse/saída), com uma
  // diferença: `kind` é enum de 1 palavra, `label` é texto livre — junta o
  // resto dos argumentos com espaço, mesma convenção de `send`/`write-sticky`
  // acima (`...msgParts`/`...textParts`), em vez de exigir aspas na linha
  // de comando. Mesma convenção de `null` literal do kind pra limpar, não
  // uma segunda (2026-09-09, achado do coordenador — paridade MCP/acbridge
  // é garantia deste repo pra toda ferramenta, `set_connector_label` não é
  // exceção).
  const [connectorId, ...labelParts] = rest;
  if (!connectorId || labelParts.length === 0) fail("usage: acbridge set-connector-label <connectorId> <label...|null>");
  const labelStr = labelParts.join(" ");
  request = { cmd: "set_connector_label", connectorId, label: labelStr === "null" ? null : labelStr };
} else if (cmd === "concurrency-status") {
  const [capStr] = rest;
  const cap = capStr === undefined ? undefined : Number(capStr);
  if (cap !== undefined && Number.isNaN(cap)) fail("concurrency-status: cap must be a number");
  request = { cmd: "concurrency_status", cap };
} else if (cmd === "board-mode") {
  const [target] = rest;
  if (!target) fail("usage: acbridge board-mode <cardId>");
  request = { cmd: "board_mode", target };
} else if (cmd === "spawn-agent") {
  // Review adversarial (2026-09-10, card 321) — esta superfície tinha ficado
  // para trás: o alargamento do enum de `effort` (low/medium/high/xhigh/max)
  // chegou ao MCP e ao bus, mas o acbridge nem `model` nem `effort` aceitava,
  // então quem spawna pela CLI não conseguia pedir o que o resto do app já
  // sabia gravar. Flags opcionais no mesmo padrão de `--anchor`/`--side` do
  // spawn-card logo abaixo, então chamador antigo (só posicionais) segue
  // idêntico. A validação por provider (antigravity só low/high) vive no bus,
  // não aqui — um único lugar que decide, e a CLI recebe o erro dele.
  //
  // `--task`/`--role`/`--brief` (2026-09-13) — mesma paridade: `taskId`
  // chegou ao MCP em 0955373 sem chegar aqui, e `role` nasce nos dois ao
  // mesmo tempo. `--brief` é UM argumento (aspas no shell); a regra
  // taskId-ou-brief (e a exceção pro reviewer) vive no bus, não aqui.
  const positional = [];
  let model, effort, taskId, role, brief;
  for (let i = 0; i < rest.length; i++) {
    if (rest[i] === "--model") model = rest[++i];
    else if (rest[i] === "--effort") effort = rest[++i];
    else if (rest[i] === "--task") taskId = rest[++i];
    else if (rest[i] === "--role") role = rest[++i];
    else if (rest[i] === "--brief") brief = rest[++i];
    else positional.push(rest[i]);
  }
  const [provider, cwd, resumeId] = positional;
  if (!provider)
    fail(
      "usage: acbridge spawn-agent <provider> [cwd] [resumeId] [--model <model>] [--effort <low|medium|high|xhigh|max>] [--task <taskId>] [--role <implementer|reviewer>] [--brief <text>]",
    );
  request = { cmd: "spawn_agent", provider, cwd, resumeId, model, effort, taskId, role, brief, requesterId: ownCardId };
} else if (cmd === "spawn-card") {
  // Pendentes #188 ("spawn_card por coordenadas") — `--anchor`/`--side` are
  // optional trailing flags, stripped out before the positional kind/
  // cwdOrUrl below so existing callers (no flags) parse identically to
  // before.
  const positional = [];
  let anchorCardId, side;
  for (let i = 0; i < rest.length; i++) {
    if (rest[i] === "--anchor") anchorCardId = rest[++i];
    else if (rest[i] === "--side") side = rest[++i];
    else positional.push(rest[i]);
  }
  const [kind, cwdOrUrl] = positional;
  if (!kind) fail("usage: acbridge spawn-card <files|changes|sticky|browser|remote-window> [cwd|url] [--anchor <cardId>] [--side <left|right|top|bottom>]");
  request =
    kind === "browser"
      ? { cmd: "spawn_card", kind, url: cwdOrUrl, requesterId: ownCardId, anchorCardId, side }
      : { cmd: "spawn_card", kind, cwd: cwdOrUrl, requesterId: ownCardId, anchorCardId, side };
} else if (cmd === "browser-click") {
  // Selector-only via the CLI (unlike the MCP `browser_click` tool,
  // which also takes raw x/y) — a human/script typing this by hand has
  // a CSS selector far more often than a computed pixel coordinate, and
  // this file has no precedent for optional-flag parsing to disambiguate
  // "selector" from "x y" cleanly.
  const [target, selector] = rest;
  if (!target || !selector) fail("usage: acbridge browser-click <cardId> <selector>");
  request = { cmd: "browser_click", target, selector };
} else if (cmd === "browser-type") {
  const [target, selector, ...textParts] = rest;
  if (!target || !selector || textParts.length === 0) fail("usage: acbridge browser-type <cardId> <selector> <text...>");
  request = { cmd: "browser_type", target, selector, text: textParts.join(" ") };
} else if (cmd === "browser-scroll") {
  const [target, dxStr, dyStr, selector] = rest;
  if (!target) fail("usage: acbridge browser-scroll <cardId> <dx> <dy> [selector]");
  const dx = Number(dxStr ?? 0);
  const dy = Number(dyStr ?? 0);
  if (Number.isNaN(dx) || Number.isNaN(dy)) fail("browser-scroll: dx/dy must be numbers");
  request = { cmd: "browser_scroll", target, dx, dy, selector };
} else if (cmd === "browser-query") {
  const [target, selector] = rest;
  if (!target || !selector) fail("usage: acbridge browser-query <cardId> <selector>");
  request = { cmd: "browser_query", target, selector };
} else if (cmd === "browser-snapshot") {
  const [target] = rest;
  if (!target) fail("usage: acbridge browser-snapshot <cardId>");
  request = { cmd: "browser_snapshot", target };
} else if (cmd === "browser-console") {
  const [target, level] = rest;
  if (!target) fail("usage: acbridge browser-console <cardId> [error|warning|info|debug]");
  request = { cmd: "browser_console", target, level };
} else if (cmd === "browser-network") {
  // `failed` como segundo argumento posicional: é de longe o uso comum
  // ("o que deu errado?"), e uma flag aqui seria mais cerimônia que ajuda.
  const [target, failed] = rest;
  if (!target) fail("usage: acbridge browser-network <cardId> [failed]");
  request = { cmd: "browser_network", target, failedOnly: failed === "failed" };
} else if (cmd === "browser-wait-for") {
  const [target, kind, ...valueParts] = rest;
  if (!target || (kind !== "text" && kind !== "selector") || valueParts.length === 0) {
    fail("usage: acbridge browser-wait-for <cardId> <text|selector> <value...>");
  }
  const value = valueParts.join(" ");
  request = { cmd: "browser_wait_for", target, ...(kind === "text" ? { text: value } : { selector: value }) };
} else if (cmd === "browser-eval") {
  const [target, ...jsParts] = rest;
  if (!target || jsParts.length === 0) fail("usage: acbridge browser-eval <cardId> <js...>");
  request = { cmd: "browser_eval", target, js: jsParts.join(" ") };
} else {
  fail(`${USAGE}\n${BASH_CARD_NOTE}`);
}

// Carimbo em TODO request, num lugar só — nenhum ramo acima precisa
// lembrar. O bus tira a chave antes do dispatch.
request = { ...request, protocol: ACBRIDGE_PROTOCOL };

const socket = net.connect({ path: sockPath }, () => {
  socket.end(JSON.stringify(request) + "\n");
});

let buf = "";
socket.on("data", (chunk) => {
  buf += chunk.toString("utf8");
});
socket.on("error", (err) => fail(err.message));
socket.on("close", () => {
  const line = (buf.split("\n")[0] ?? "").trim();
  let res;
  try {
    res = JSON.parse(line);
  } catch {
    fail("bad response from agent-canvas");
    return;
  }
  if (!res.ok) {
    // Bus anterior ao handshake (todo Stellar empacotado antes do
    // protocolo 1): não conhece `hello`, e também não conhece nada que
    // este script ganhou desde então. Nomeie isso em vez de deixar o
    // "unknown cmd" cru parecer um typo.
    if (cmd === "version" && /unknown cmd "hello"/.test(String(res.error ?? ""))) {
      console.log(`acbridge protocol ${ACBRIDGE_PROTOCOL}\tbus protocol pre-1 (no handshake)\tMISMATCH`);
      fail("the running Stellar predates the acbridge protocol handshake — it is older than this acbridge; restart it with a matching build");
      return;
    }
    fail(res.error ?? "request failed");
    return;
  }
  // Bus mais novo que este script: o request foi aceito (é subconjunto),
  // mas o agente precisa VER que está num acbridge atrasado — stderr, que
  // aparece na saída da tool junto com o resultado.
  if (typeof res.warning === "string" && res.warning) process.stderr.write(`acbridge: ${res.warning}\n`);
  if (cmd === "version") {
    const busProtocol = res.protocol;
    const verdict = busProtocol === ACBRIDGE_PROTOCOL ? "match" : "MISMATCH";
    console.log(`acbridge protocol ${ACBRIDGE_PROTOCOL}\tbus protocol ${busProtocol ?? "unknown"}\t${verdict}`);
  } else if (cmd === "list") {
    // `kind` e `label` são novos (2026-09-01): a lista deixou de ser só de
    // terminais, então o tipo do card passa a ser a informação que decide
    // o que dá pra fazer com ele, e o rótulo é um alvo válido em qualquer
    // comando que aceita <cardId>.
    const others = (res.cards ?? []).filter((c) => c.id !== ownCardId);
    if (others.length === 0) console.log("(no other cards open)");
    else for (const c of others) console.log([c.id, c.kind ?? "terminal", c.label ?? "-", c.provider ?? "", c.url ?? c.cwd ?? ""].join("\t"));
  } else if (cmd === "send") {
    // Receipt, not a lie that typing already finished. Same fields as
    // the MCP send_to_card return — poll get-delivery with `id`.
    console.log(JSON.stringify({ delivery: res.delivery, reason: res.reason, id: res.id }));
  } else if (cmd === "get-delivery") {
    // `delivery` settles to delivered | failed | unconfirmed — the screen
    // confirmation's verdict, not "the FIFO item finished". `confirm` is
    // the raw finding behind it (result, attempts, enters, composerCleared).
    console.log(JSON.stringify({ delivery: res.delivery, reason: res.reason, confirm: res.confirm, id: res.id, target: res.target }));
  } else if (cmd === "open") {
    // O cardId agora vem junto (2026-09-01) — é ele que serve de alvo pros
    // comandos `browser-*` e `page-text` no card recém-aberto.
    console.log(res.cardId ? `opened: ${rest[0]}\t${res.cardId}` : `opened: ${rest[0]}`);
  } else if (cmd === "close-card" || cmd === "delete-card") {
    console.log(`${cmd === "delete-card" ? "deleted" : "closed"}: ${rest[0]}`);
  } else if (cmd === "snapshot") {
    // Just the path, nothing else — meant to be read directly (Claude
    // Code's own Read tool renders an image path), not parsed.
    console.log(res.path);
  } else if (cmd === "page-text") {
    console.log(res.text);
    if (res.truncated) process.stderr.write("acbridge: page text truncated\n");
  } else if (cmd === "read-card") {
    console.log(res.text);
  } else if (cmd === "read-sticky" || cmd === "write-sticky" || cmd === "update-card-content") {
    console.log(res.content);
  } else if (cmd === "browser-snapshot") {
    // Uma linha por elemento, no formato que um humano lê de relance —
    // o JSON cru some numa parede de chaves. `ref` primeiro porque é o
    // que vai de volta no próximo comando.
    for (const el of res.elements ?? []) console.log(`${el.ref}\t${el.role}\t${el.name}`);
    if (res.truncated) process.stderr.write("acbridge: lista de elementos truncada\n");
  } else if (cmd === "browser-console") {
    for (const m of res.messages ?? []) console.log(`${m.level}\t${m.message}`);
  } else if (cmd === "browser-network") {
    for (const r of res.requests ?? []) console.log(`${r.status ?? r.error ?? "?"}\t${r.method}\t${r.url}`);
  } else if (cmd === "browser-wait-for") {
    console.log(`ok after ${res.waitedMs}ms`);
  } else if (cmd === "card-status") {
    console.log(res.status);
  } else if (cmd === "report") {
    console.log("reported");
  } else if (cmd === "read-report") {
    console.log(JSON.stringify(res.report));
  } else if (cmd === "create-task") {
    console.log(res.taskId);
  } else if (cmd === "update-task") {
    console.log("updated");
  } else if (cmd === "request-task-status") {
    console.log(JSON.stringify({ pending: res.pending, already: res.already, status: res.status, requestedStatus: res.requestedStatus, message: res.message }));
  } else if (cmd === "list-tasks") {
    console.log(JSON.stringify(res.tasks));
  } else if (cmd === "get-task") {
    console.log(JSON.stringify(res.task));
  } else if (cmd === "link-task-card") {
    console.log(`linked ${res.cardId} as ${res.role}`);
  } else if (cmd === "list-connectors") {
    console.log(JSON.stringify(res.connectors));
  } else if (cmd === "set-connector-kind" || cmd === "set-connector-label") {
    console.log("updated");
  } else if (cmd === "concurrency-status") {
    console.log(JSON.stringify({ running: res.running, cap: res.cap, atCap: res.atCap }));
  } else if (cmd === "board-mode") {
    console.log(String(res.autonomous));
  } else if (cmd === "spawn-agent") {
    console.log(res.cardId);
  } else if (cmd === "spawn-card") {
    console.log(res.cardId);
  } else if (cmd === "browser-click") {
    console.log("clicked");
  } else if (cmd === "browser-type") {
    console.log("typed");
  } else if (cmd === "browser-scroll") {
    console.log("scrolled");
  } else if (cmd === "browser-query") {
    const { ok, ...rest } = res;
    console.log(JSON.stringify(rest));
  } else if (cmd === "browser-eval") {
    console.log(res.result);
    if (res.truncated) process.stderr.write("acbridge: eval result truncated\n");
  }
  process.exit(0);
});
