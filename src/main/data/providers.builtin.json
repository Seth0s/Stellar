{
  "providers": [
    {
      "id": "cline",
      "label": "Cline",
      "binaryNames": ["cline"],
      "installCommand": {
        "posix": "npm install -g cline",
        "windows": "npm install -g cline"
      },
      "baseArgs": ["--tui"],
      "configHome": { "flag": "--config" },
      "capacity": {
        "role": "agent",
        "session": {
          "canImposeSessionId": false,
          "resumeFlag": "--id",
          "store": {
            "kind": "sqlite",
            "db": "~/.cline/data/db/sessions.db",
            "timeFormat": "iso-8601",
            "discovery": {
              "table": "sessions",
              "idColumn": "session_id",
              "cwdColumn": "cwd",
              "timeColumn": "started_at"
            }
          }
        },
        "systemPrompt": {
          "mechanism": "flag",
          "flag": "-s"
        },
        "mcp": {
          "mechanism": "global-config",
          "configPath": "~/.cline/data/settings/cline_mcp_settings.json",
          "configKey": "mcpServers",
          "serverShape": "stdio-command"
        },
        "acbridgeOnPath": true,
        "effort": {
          "mechanism": "flag",
          "flag": "--thinking",
          "values": ["none", "low", "medium", "high", "xhigh"]
        },
        "model": {
          "mechanism": "flag",
          "flag": "-m"
        },
        "delivery": {
          "briefMechanism": "positional",
          "midTurnQueue": {
            "parkedPattern": "queued messages[\\s\\S]*?enter with empty input to steer",
            "steerKey": "\r"
          }
        }
      }
    },
    {
      "id": "commandcode",
      "label": "Command Code",
      "binaryNames": ["commandcode", "command-code"],
      "installCommand": {
        "posix": "npm install -g command-code",
        "windows": "npm install -g command-code"
      },
      "baseArgs": ["--yolo", "--skip-onboarding"],
      "bypassesPermissionPrompts": true,
      "capacity": {
        "role": "agent",
        "session": {
          "canImposeSessionId": false,
          "resumeFlag": "--resume",
          "store": {
            "kind": "files",
            "root": "~/.commandcode/projects/{cwd:slug}",
            "pattern": "*.meta.json",
            "id": {
              "from": "fileName",
              "strip": ".meta.json"
            },
            "cwd": {
              "from": "root"
            },
            "time": {
              "from": "mtime"
            },
            "read": {
              "exists": "{id}.jsonl",
              "content": {
                "minBytes": 16
              }
            },
            "prompt": {
              "file": "{id}.checkpoints.jsonl",
              "field": "prompt"
            }
          }
        },
        "systemPrompt": {
          "mechanism": "none"
        },
        "mcp": {
          "mechanism": "global-config",
          "configPath": "~/.commandcode/mcp.json",
          "configKey": "mcpServers",
          "serverShape": "stdio-command"
        },
        "acbridgeOnPath": true,
        "effort": {
          "mechanism": "flag",
          "flag": "--effort",
          "values": ["low", "medium", "high", "xhigh", "max"]
        },
        "model": {
          "mechanism": "flag",
          "flag": "-m"
        },
        "delivery": {
          "briefMechanism": "positional",
          "submitStartedPattern": "(?:esc to interrupt)|(?:[●○✻✽✳]\\s*[A-Z][a-z]+…)",
          "turnEnd": {
            "mechanism": "screen",
            "pattern": "Worked for (?:\\d+h\\s*)?(?:\\d+m\\s*)?\\d+(?:s| seconds?)"
          }
        },
        "oneShot": {
          "mechanism": "argv",
          "args": ["-p", "{prompt}"],
          "result": "stdout-text"
        }
      }
    },
    {
      "id": "opencode",
      "label": "OpenCode",
      "binaryNames": ["opencode"],
      "configHome": { "env": "OPENCODE_CONFIG_DIR" },
      "installCommand": {
        "posix": "npm install -g opencode-ai",
        "windows": "npm install -g opencode-ai"
      },
      "capacity": {
        "role": "agent",
        "session": {
          "canImposeSessionId": false,
          "resumeFlag": "--session",
          "continueFlag": "--continue",
          "store": {
            "kind": "sqlite",
            "db": "~/.local/share/opencode/opencode.db",
            "discovery": {
              "table": "session",
              "idColumn": "id",
              "cwdColumn": "directory",
              "timeColumn": "time_created"
            },
            "read": {
              "table": "session",
              "idColumn": "id",
              "timeColumn": "time_updated",
              "contentTable": "message",
              "contentColumn": "session_id"
            }
          }
        },
        "systemPrompt": { "mechanism": "none" },
        "mcp": {
          "mechanism": "global-config",
          "configPath": "~/.config/opencode/opencode.json",
          "configKey": "mcp",
          "serverShape": "remote-url",
          "urlSyntax": "brace-env"
        },
        "acbridgeOnPath": true,
        "effort": { "mechanism": "none", "reason": "no-flag" },
        "model": { "mechanism": "flag", "flag": "--model" },
        "delivery": { "briefMechanism": "flag", "briefFlag": "--prompt" }
      }
    }
  ]
}
