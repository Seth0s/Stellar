{
  "name": "agent-canvas",
  "version": "0.5.0",
  "description": "Stellar — a multi-agent spatial canvas for orchestrating Claude/Codex/Cursor/bash sessions.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Seth0s/Stellar",
  "author": {
    "name": "Seth0s",
    "email": "seth0s@users.noreply.github.com"
  },
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "desktopName": "stellar.desktop",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --dir",
    "package:rpm": "electron-vite build && electron-builder --linux rpm",
    "package:linux": "electron-vite build && electron-builder --linux",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:win": "electron-vite build && electron-builder --win",
    "postinstall": "electron-rebuild -f -w node-pty -w better-sqlite3",
    "lint": "eslint .",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test:unit": "vitest run",
    "verify": "npx tsc --noEmit && npm run test:unit && npm run build && for f in scripts/verify/smoke-*.mjs; do node \"$f\" || exit 1; done"
  },
  "build": {
    "appId": "com.stellar.app",
    "productName": "Stellar",
    "icon": "build/icon.png",
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      },
      {
        "from": "resources/mobile-client",
        "to": "mobile-client"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "Seth0s",
      "repo": "Stellar",
      "releaseType": "release"
    },
    "linux": {
      "target": [
        "rpm",
        "deb"
      ],
      "executableName": "stellar",
      "category": "Development",
      "synopsis": "Multi-agent spatial canvas",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "syncDesktopName": true,
      "icon": "build/icons"
    },
    "rpm": {
      "packageName": "stellar",
      "vendor": "Seth0s",
      "afterInstall": "build/linux-after-install.sh"
    },
    "deb": {
      "packageName": "stellar",
      "vendor": "Seth0s",
      "afterInstall": "build/linux-after-install.sh"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@azurity/pure-nerd-font": "^3.0.5",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-ligatures": "^0.10.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "13.0.3",
    "codemirror": "^6.0.2",
    "dbus-next": "^0.10.2",
    "diff": "^9.0.0",
    "dompurify": "^3.4.14",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.34.0",
    "marked": "^18.0.11",
    "node-pty": "1.1.0",
    "openai": "^7.7.0",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@electron/rebuild": "4.0.4",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "42.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "prettier": "^3.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
