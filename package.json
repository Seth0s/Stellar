{
  "name": "agent-canvas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --dir",
    "postinstall": "electron-rebuild -f -w node-pty -w better-sqlite3"
  },
  "build": {
    "appId": "com.agentcanvas.app",
    "productName": "agent-canvas",
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      },
      {
        "from": "resources/mobile-client",
        "to": "mobile-client"
      }
    ]
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "13.0.3",
    "dbus-next": "^0.10.2",
    "dompurify": "^3.4.14",
    "lucide-react": "^1.34.0",
    "marked": "^18.0.11",
    "node-pty": "1.1.0",
    "qrcode": "^1.5.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@electron/rebuild": "4.0.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "42.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
